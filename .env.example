# Copie para .env (nunca versione o .env).
# Sem DATABASE_URL, o modo de desenvolvimento usa PGlite (Postgres embutido) em ./data/pglite.
# DATABASE_URL=postgres://brasfc:troque-esta-senha@localhost:5432/brasfc

# Origem pública usada pelo servidor de produção (adapter-node).
# ORIGIN=https://brasfc.exemplo.com.br

# Ambiente exibido na interface (desenvolvimento | staging | producao).
PUBLIC_BRASFC_ENV=desenvolvimento
