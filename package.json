{
  "name": "brasfc",
  "version": "0.9.1",
  "private": true,
  "description": "BRASFC — simulador brasileiro de futebol com carreiras de treinador e jogador.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run check && npm run test && npm run build"
  },
  "dependencies": {
    "postgres": "3.4.9",
    "ultra-motion-x": "https://codeload.github.com/Andresilvadev-br/ULTRA-MOTION-X/tar.gz/25344fb5d525613860402e2a13ee22f782333eaa",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@sveltejs/adapter-node": "6.0.4",
    "@sveltejs/kit": "3.2.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}
